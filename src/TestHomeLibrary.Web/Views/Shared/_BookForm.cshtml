@model TestHomeLibrary.Web.Models.BookEditViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row mb-3">
    <div class="col-md-6">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" maxlength="500" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Author" class="form-label"></label>
        <input asp-for="Author" class="form-control" maxlength="300" />
        <span asp-validation-for="Author" class="text-danger"></span>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <label asp-for="PublicationYear" class="form-label"></label>
        <input asp-for="PublicationYear" class="form-control" type="number" min="1450" max="2200" />
        <span asp-validation-for="PublicationYear" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="PageCount" class="form-label"></label>
        <input asp-for="PageCount" class="form-control" type="number" min="1" />
        <span asp-validation-for="PageCount" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Publisher" class="form-label"></label>
        <input asp-for="Publisher" class="form-control" maxlength="300" />
        <span asp-validation-for="Publisher" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Isbn" class="form-label"></label>
        <input asp-for="Isbn" class="form-control" maxlength="20" />
        <span asp-validation-for="Isbn" class="text-danger"></span>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <label asp-for="Genre" class="form-label"></label>
        <input asp-for="Genre" class="form-control" maxlength="100" />
        <span asp-validation-for="Genre" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Notes" class="form-label"></label>
    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Notes" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="TableOfContentsHtml" class="form-label">Оглавление</label>
    <textarea asp-for="TableOfContentsHtml" id="TableOfContentsHtml" class="form-control" rows="12"></textarea>
    <div class="form-text">Оглавление редактируется в HTML-редакторе и сохраняется в XML-поле базы данных.</div>
    <span asp-validation-for="TableOfContentsHtml" class="text-danger"></span>
</div>
