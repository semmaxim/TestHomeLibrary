@model BookDto
@{
    ViewData["Title"] = "Удалить: " + Model.Title;
}

<h1>Удалить книгу</h1>

<div class="alert alert-warning">
    Вы уверены, что хотите удалить книгу <strong>«@Model.Title»</strong> (@Model.Author, @Model.PublicationYear)?
    Это действие нельзя отменить.
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Название</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Автор</dt>
            <dd class="col-sm-9">@Model.Author</dd>

            <dt class="col-sm-3">Год издания</dt>
            <dd class="col-sm-9">@Model.PublicationYear</dd>

            <dt class="col-sm-3">Издательство</dt>
            <dd class="col-sm-9">@(Model.Publisher ?? "—")</dd>

            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@(Model.Isbn ?? "—")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
    </div>
</form>
