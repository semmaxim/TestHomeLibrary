@model BookEditViewModel
@{
    ViewData["Title"] = "Изменить: " + Model.Title;
}

<h1>Изменить книгу</h1>
<hr />

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_BookForm" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Отмена</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_HtmlEditorScripts" />
}
