@model BookListViewModel
@{
    ViewData["Title"] = "Книги";
}

<h1>Домашняя библиотека</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <form asp-action="Index" method="get" class="d-flex gap-2 flex-grow-1" role="search" style="min-width: 320px;">
        <input type="hidden" name="page" value="1" />
        <input type="search"
               name="q"
               value="@Model.Query"
               class="form-control"
               style="max-width: 420px;"
               placeholder="Поиск по названию, автору или оглавлению..." />
        <button type="submit" class="btn btn-outline-primary">Найти</button>
        @if (Model.IsSearch)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        }
    </form>
    <a asp-action="Create" class="btn btn-primary">Добавить книгу</a>
</div>

@if (Model.IsSearch)
{
    <p class="text-muted">Найдено записей: <strong>@Model.TotalCount</strong> по запросу «@Model.Query»</p>
}

@if (Model.Items.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>
                        @if (Model.IsSearch)
                        {
                            <span>Название</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="1" asp-route-sort="title" asp-route-dir="@Model.NextDirection("title")" asp-route-q="@Model.Query">
                                Название @(Model.IsSortActive("title") ? (Model.Dir == "asc" ? "▲" : "▼") : "")
                            </a>
                        }
                    </th>
                    <th>
                        @if (Model.IsSearch)
                        {
                            <span>Автор</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="1" asp-route-sort="author" asp-route-dir="@Model.NextDirection("author")" asp-route-q="@Model.Query">
                                Автор @(Model.IsSortActive("author") ? (Model.Dir == "asc" ? "▲" : "▼") : "")
                            </a>
                        }
                    </th>
                    <th>
                        @if (Model.IsSearch)
                        {
                            <span>Год</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="1" asp-route-sort="year" asp-route-dir="@Model.NextDirection("year")" asp-route-q="@Model.Query">
                                Год @(Model.IsSortActive("year") ? (Model.Dir == "asc" ? "▲" : "▼") : "")
                            </a>
                        }
                    </th>
                    <th>
                        @if (Model.IsSearch)
                        {
                            <span>Издательство</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="1" asp-route-sort="publisher" asp-route-dir="@Model.NextDirection("publisher")" asp-route-q="@Model.Query">
                                Издательство @(Model.IsSortActive("publisher") ? (Model.Dir == "asc" ? "▲" : "▼") : "")
                            </a>
                        }
                    </th>
                    <th>ISBN</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Author</td>
                        <td>@item.PublicationYear</td>
                        <td>@item.Publisher</td>
                        <td>@item.Isbn</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Просмотр</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Навигация по страницам">
            <ul class="pagination">
                <li class="page-item @(Model.HasPrevious ? null : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-q="@Model.Query"
                       asp-route-sort="@Model.Sort"
                       asp-route-dir="@Model.Dir">Назад</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Страница @Model.Page из @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.HasNext ? null : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-q="@Model.Query"
                       asp-route-sort="@Model.Sort"
                       asp-route-dir="@Model.Dir">Вперёд</a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="alert alert-info">
        @if (Model.IsSearch)
        {
            <span>По запросу «@Model.Query» ничего не найдено.</span>
        }
        else
        {
            <span>Библиотека пуста. <a asp-action="Create">Добавьте первую книгу</a>.</span>
        }
    </div>
}
